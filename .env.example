# Next.js server-side database connection
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Python ingestion worker
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SUPABASE_SERVICE_ROLE_KEY=

# JobSpy sources. LinkedIn is opt-in and should only be enabled with explicit source permission.
JOB_SOURCES=indeed,naukri,glassdoor
ENABLE_LINKEDIN=false
JOB_SEARCH_TERMS=software engineer fresher,frontend developer fresher,backend developer fresher,data analyst fresher,AI ML intern,graduate engineer trainee

# Proxies are optional. A source may use a proxy only when it is explicitly listed here
# AND the proxy/source combination is authorised by the source owner.
AUTHORIZED_PROXY_SOURCES=
PROXY_INDEED=
PROXY_NAUKRI=
PROXY_GLASSDOOR=
PROXY_LINKEDIN=

# Optional worker controls
RESULTS_PER_SEARCH=40
MAX_JOBS_PER_RUN=500
